rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Music Library Collection
    // Stores metadata for music files (actual files stored locally in project)
    match /music_library/{musicId} {
      // Anyone authenticated can read
      allow read: if request.auth != null;
      
      // Only the uploader can write/update/delete their own music
      allow create: if request.auth != null 
                    && request.resource.data.uploadedBy == request.auth.uid;
      allow update, delete: if request.auth != null 
                            && resource.data.uploadedBy == request.auth.uid;
    }
    
    // Playlists Collection
    // User-created playlists
    match /playlists/{playlistId} {
      // Anyone authenticated can read
      allow read: if request.auth != null;
      
      // Only the owner can create/update/delete their playlists
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null 
                            && resource.data.userId == request.auth.uid;
    }
    
    // User Profiles Collection (optional)
    match /users/{userId} {
      // Users can read their own profile and public profiles
      allow read: if request.auth != null;
      
      // Users can only write to their own profile
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Favorites Collection (optional)
    match /favorites/{userId} {
      // Only the user can access their favorites
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Albums Collection
    // User-created albums for organizing music
    match /albums/{albumId} {
      // Anyone authenticated can read
      allow read: if request.auth != null;
      
      // Only the creator can create/update/delete their albums
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null 
                            && resource.data.userId == request.auth.uid;
    }
  }
}