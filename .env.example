# Supabase Configuration - KinoVibes Music Player
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# Copy this file to .env and fill in your actual values

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Spotify (optional) — public client id only, OAuth PKCE (no secret).
# Create an app at https://developer.spotify.com/dashboard and register the
# redirect URI <origin>/profile for every origin you use, e.g.:
#   http://localhost:5173/profile
#   https://kino-vibes-music-player.vercel.app/profile
#   https://kinovibe.han06.web.id/profile
# Full ad-free playback requires the listener's Spotify Premium account.
VITE_SPOTIFY_CLIENT_ID=
