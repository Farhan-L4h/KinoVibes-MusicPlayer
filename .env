# Firebase Configuration - KinoVibe Music Player
# For development, we use Firebase emulators
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-kinovibe
VITE_FIREBASE_STORAGE_BUCKET=demo-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:demo123

# Development mode
VITE_USE_FIREBASE_EMULATOR=true

# Spotify API (for later)
VITE_SPOTIFY_CLIENT_ID=your-spotify-client-id
VITE_SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Lyrics API (for later)
VITE_LYRICS_API_KEY=your-lyrics-api-key